@model List<KnustHallMaintenance.Models.ApplicationUser>

@using KnustHallMaintenance.Models

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">

    <div class="eyebrow">
        Administration
    </div>

    <h2>
        User Management
    </h2>

    <p>
        Manage hall staff, maintenance personnel and administrator accounts.
    </p>

</div>


<!-- =========================================================
     ALERTS
     ========================================================= -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4">
        @TempData["Error"]
    </div>
}


<!-- =========================================================
     ACTION BAR
     ========================================================= -->

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <div class="section-title">
            Portal Users
        </div>

        <div class="small text-muted">
            @Model.Count user(s) registered in the system.
        </div>
    </div>


    <a asp-controller="Admin"
       asp-action="CreateUser"
       class="btn btn-knust">

        + Add User

    </a>

</div>


<!-- =========================================================
     USERS TABLE
     ========================================================= -->

<div class="card-soft">

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead>

                <tr>

                    <th>
                        User
                    </th>

                    <th>
                        Email
                    </th>

                    <th>
                        Role
                    </th>

                    <th>
                        Hall
                    </th>

                    <th>
                        Specialization
                    </th>

                    <th>
                        Status
                    </th>

                    <th class="text-end">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="7"
                            class="text-center text-muted py-5">

                            No portal users found.

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var user in Model)
                    {
                        <tr>

                            <!-- =================================================
                                 USER
                                 ================================================= -->

                            <td>

                                <div class="fw-semibold">
                                    @user.FullName
                                </div>

                            </td>


                            <!-- =================================================
                                 EMAIL
                                 ================================================= -->

                            <td>

                                <span class="small">
                                    @user.Email
                                </span>

                            </td>


                            <!-- =================================================
                                 ROLE
                                 ================================================= -->

                            <td>

                                @switch (user.Role)
                                {
                                    case UserRole.Admin:

                                        <span class="badge bg-dark">
                                            Administrator
                                        </span>

                                        break;


                                    case UserRole.HallStaff:

                                        <span class="badge bg-secondary">
                                            Hall Staff
                                        </span>

                                        break;


                                    case UserRole.Maintenance:

                                        <span class="badge bg-info text-dark">
                                            Maintenance
                                        </span>

                                        break;


                                    default:

                                        <span class="badge bg-secondary">
                                            @user.Role
                                        </span>

                                        break;
                                }

                            </td>


                            <!-- =================================================
                                 HALL
                                 ================================================= -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(user.Hall))
                                {
                                    <span>
                                        @user.Hall
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- =================================================
                                 SPECIALIZATION
                                 ================================================= -->

                            <td>

                                @if (
                                    user.Role == UserRole.Maintenance &&
                                    user.MaintenanceSpecialization.HasValue
                                )
                                {
                                    <span>
                                        @user.MaintenanceSpecialization
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- =================================================
                                 STATUS
                                 ================================================= -->

                            <td>

                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <!-- =================================================
                                 ACTIONS
                                 ================================================= -->

                            <td>

                                <div class="d-flex justify-content-end gap-2 flex-wrap">

                                    <!-- EDIT -->

                                    <a asp-controller="Admin"
                                       asp-action="EditUser"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-secondary">

                                        Edit

                                    </a>


                                    @if (user.Role != UserRole.Admin)
                                    {
                                        <!-- ACTIVATE / DEACTIVATE -->

                                        <form asp-controller="Admin"
                                              asp-action="ToggleActive"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            @if (user.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning">

                                                    Deactivate

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">

                                                    Activate

                                                </button>
                                            }

                                        </form>


                                        <!-- DELETE -->

                                        <form asp-controller="Admin"
                                              asp-action="DeleteUser"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to permanently delete this user? This cannot be undone.');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">

                                                Delete

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>


<!-- =========================================================
     INFORMATION PANEL
     ========================================================= -->

<div class="row g-4 mt-4">

    <div class="col-md-4">

        <div class="card-soft p-4 h-100">

            <div class="section-title mb-2">
                Hall Staff
            </div>

            <p class="small text-muted mb-0">
                Hall staff manage complaints belonging to their
                assigned hall and assign them to maintenance workers
                within that hall.
            </p>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card-soft p-4 h-100">

            <div class="section-title mb-2">
                Maintenance
            </div>

            <p class="small text-muted mb-0">
                Maintenance personnel see work assigned to them
                and can update the progress and resolution of
                maintenance complaints.
            </p>

        </div>

    </div>


    <div class="col-md-4">

        <div class="card-soft p-4 h-100">

            <div class="section-title mb-2">
                Account Status
            </div>

            <p class="small text-muted mb-0">
                Deactivate workers who are temporarily unavailable
                without deleting their historical complaint records.
            </p>

        </div>

    </div>

</div>