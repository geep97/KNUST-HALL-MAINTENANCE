@model Complaint
@{
    ViewData["Title"] = $"Request #{Model.Id}";
}

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div class="work-order-header">
        <div class="eyebrow">My Maintenance Request</div>
        <h2 class="mb-1">#@Model.Id · @Model.Category</h2>
        <p>@Model.Hall · Room @Model.RoomNumber</p>
    </div>
    <span class="status-badge @StatusBadgeHelper.CssClass(Model.Status)">@StatusBadgeHelper.Display(Model.Status)</span>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card-soft p-4">
            <div class="section-title mb-4">Request details</div>
            <div class="detail-label">Description</div>
            <div class="detail-value">@Model.Description</div>

            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <div class="detail-label">Attached photo</div>
                <img src="@Model.PhotoPath" class="img-fluid rounded border mb-2" style="max-height:340px;" alt="Maintenance issue photo" />
            }

            <div class="row mt-3">
                <div class="col-sm-6">
                    <div class="detail-label">Reported</div>
                    <div class="detail-value mb-0">@Model.DateCreated.ToString("dd MMM yyyy, h:mm tt")</div>
                </div>
                <div class="col-sm-6">
                    <div class="detail-label">Assigned technician</div>
                    <div class="detail-value mb-0">@(Model.AssignedTo?.FullName ?? "Awaiting assignment")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card-soft p-4">
            <div class="section-title mb-4">Request activity</div>
            @if (!Model.Updates.Any())
            {
                <p class="text-muted mb-0">Your request has been submitted and is awaiting review.</p>
            }
            else
            {
                foreach (var u in Model.Updates.OrderByDescending(x => x.Timestamp))
                {
                    <div class="timeline-item">
                        <span class="timeline-dot"></span>
                        <div class="fw-semibold small">@u.Note</div>
                        <div class="text-muted small mt-1">@u.Timestamp.ToString("dd MMM yyyy, h:mm tt")</div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<a asp-action="MyComplaints" class="btn btn-outline-secondary mt-4">← Back to my requests</a>
