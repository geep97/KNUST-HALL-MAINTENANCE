@model LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="login-page">

    <div class="login-card p-4 p-md-5">

        <div class="login-mark mb-3">
            KNUST · HALL FACILITIES
        </div>

        <h1 class="login-title mb-1">
            Hall Maintenance Portal
        </h1>

        <p class="text-muted mb-4">
            Sign in to report, assign or resolve hall maintenance requests.
        </p>


        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }


        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()


            <!-- EMAIL OR STUDENT ID -->

            <div class="mb-3">

                <label asp-for="EmailOrStudentId"
                       class="form-label">
                    University email or Student ID
                </label>

                <input asp-for="EmailOrStudentId"
                       class="form-control"
                       placeholder="you@knust.edu.gh or 20810001"
                       autocomplete="username" />

                <span asp-validation-for="EmailOrStudentId"
                      class="text-danger small">
                </span>

            </div>


            <!-- PASSWORD -->

            <div class="mb-4">

                <label asp-for="Password"
                       class="form-label">
                    Password
                </label>

                <input asp-for="Password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password" />

                <span asp-validation-for="Password"
                      class="text-danger small">
                </span>

            </div>


            <!-- SIGN IN -->

            <button type="submit"
                    class="btn btn-knust w-100">
                Sign in
            </button>

        </form>


        <hr class="my-4" />


 
    </div>

</div>