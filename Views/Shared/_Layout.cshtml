@using System.Security.Claims
@using KnustHallMaintenance.Models

@{
    var role = User.FindFirstValue(ClaimTypes.Role);

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - KNUST Hall Maintenance
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>


    <!-- =========================================================
         INSTITUTIONAL TOP BAR
         ========================================================= -->

    <div class="knust-topbar">

        <div class="container d-flex align-items-center justify-content-between">

            <span>
                KWAME NKRUMAH UNIVERSITY OF SCIENCE AND TECHNOLOGY
            </span>

            <span class="d-none d-md-inline">
                Hall Facilities &amp; Maintenance
            </span>

        </div>

    </div>


    <!-- =========================================================
         BRANDING HEADER
         ========================================================= -->

    <header class="knust-header">

        <div class="container">

            <a class="brand-lockup"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/crest.png"
                     alt="KNUST"
                     class="brand-logo" />

                <span class="brand-text">

                    <span class="brand-title">
                        Hall Maintenance Portal
                    </span>

                    <span class="brand-subtitle">
                        Facilities reporting and work-order management
                    </span>

                </span>

            </a>

        </div>

    </header>


    <!-- =========================================================
         NAVIGATION
         ========================================================= -->
    @if (User.Identity?.IsAuthenticated == true)
    {

        <nav class="navbar navbar-expand-md knust-nav py-0">

            <div class="container">


                <!-- MOBILE TOGGLE -->

                <button class="navbar-toggler my-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#portalNavigation"
                        aria-controls="portalNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="portalNavigation">


                    <!-- =================================================
                         ADMIN NAVIGATION
                         ================================================= -->
                    @if (role == nameof(UserRole.Admin))
                    {

                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link @(currentController == "Admin" ? "active" : "")"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    Administration

                                </a>

                            </li>

                        </ul>

                    }


                    <!-- =================================================
                         HALL STAFF NAVIGATION
                         ================================================= -->
                    @if (role == nameof(UserRole.HallStaff))
                    {

                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link @(currentController == "Staff" ? "active" : "")"
                                   asp-controller="Staff"
                                   asp-action="Index">

                                    Maintenance Requests

                                </a>

                            </li>

                        </ul>

                    }


                    <!-- =================================================
                         MAINTENANCE PERSONNEL NAVIGATION
                         ================================================= -->
                    @if (role == nameof(UserRole.Maintenance))
                    {

                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link @(currentController == "Staff" ? "active" : "")"
                                   asp-controller="Staff"
                                   asp-action="Index">

                                    My Work Orders

                                </a>

                            </li>

                        </ul>

                    }


                    <!-- =================================================
                         STUDENT NAVIGATION
                         ================================================= -->
                    @if (role == "Student")
                    {

                        <ul class="navbar-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link @(currentController == "Complaints" ? "active" : "")"
                                   asp-controller="Complaints"
                                   asp-action="MyComplaints">

                                    Maintenance Requests

                                </a>

                            </li>

                        </ul>

                    }


                    <!-- =================================================
                         USER INFORMATION
                         ================================================= -->

                    <div class="d-flex align-items-center gap-3 py-2 ms-auto">

                        <span class="user-chip">

                            @User.Identity?.Name

                            <span class="opacity-75">
                                · @role
                            </span>

                        </span>


                        <!-- LOGOUT -->

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="m-0">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-light-outline">

                                Sign out

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </nav>

    }


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <main class="main-shell">

        <div class="container pb-5">


            <!-- SUCCESS MESSAGE -->
            @if (TempData["Success"] != null)
            {

                <div class="alert alert-success border-0 shadow-sm">

                    @TempData["Success"]

                </div>

            }


            <!-- ERROR MESSAGE -->
            @if (TempData["Error"] != null)
            {

                <div class="alert alert-danger border-0 shadow-sm">

                    @TempData["Error"]

                </div>

            }


            @RenderBody()

        </div>

    </main>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="site-footer">

        <div class="container d-flex justify-content-between flex-wrap gap-2">

            <span>
                KNUST Hall Maintenance Portal
            </span>

            <span>
                Facilities &amp; Maintenance Operations
            </span>

        </div>

    </footer>


    <!-- =========================================================
         BOOTSTRAP JS
         ========================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>